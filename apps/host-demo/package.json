{
  "name": "@bookleaf/host-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A stand-in for BookLeaf's own product: owns authors and books, attaches the support module.",
  "exports": {
    ".": "./src/index.ts",
    "./dashboard": "./src/dashboard/schema.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bookleaf/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "6.1.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
