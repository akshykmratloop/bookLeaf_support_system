// BookLeaf Author Support Portal — database schema.
// Money is stored as integer paise. Nullable columns mean "unknown", never zero.

generator client {
  provider = "prisma-client-js"
}

// The CLI (migrations) connects as the owner. At runtime the API passes both URLs explicitly:
// DATABASE_URL (restricted app role, under row-level security) and DATABASE_ADMIN_URL (S.8).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_ADMIN_URL")
}

enum Role {
  AUTHOR
  ADMIN
}

/// What a staff member may do in a workspace. OWNER: everything incl. billing and deletion.
enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
}

/// The shape of one customer-data field a workspace defines (matches Fact.type).
enum CustomerFieldType {
  MONEY
  DATE
  TEXT
  STATUS
  NUMBER
}

enum BookStage {
  MANUSCRIPT_RECEIVED
  EDITING
  COVER_DESIGN
  TYPESETTING
  PROOFREADING
  ISBN_ASSIGNMENT
  PRINTING
  DISTRIBUTION_SETUP
  PUBLISHED_LIVE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// BookLeaf's original fixed categories. Kept only for the old `category` columns until they are
/// dropped (S.9 expand → backfill → contract); categories now live in `ticket_categories`.
enum TicketCategory {
  ROYALTY_PAYMENTS
  ISBN_METADATA
  PRINTING_QUALITY
  DISTRIBUTION_AVAILABILITY
  BOOK_STATUS_PRODUCTION
  GENERAL_INQUIRY
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FieldSource {
  AI
  RULES
  ADMIN
  /// Chosen by the author (issue type picked in the ticket draft); triage keeps it.
  AUTHOR
}

enum TicketDraftStatus {
  OPEN
  /// The assistant read the draft back and asked the author to confirm sending it.
  AWAITING_CONFIRMATION
  SUBMITTED
}

enum DraftEditor {
  AUTHOR
  ASSISTANT
}

enum AiState {
  PENDING
  DONE
  FALLBACK
}

enum TicketSource {
  PORTAL
  CHAT
  VOICE
  /// Raised by the workspace's own server through the server API (U-11).
  API
}

enum ChatRole {
  AUTHOR
  ASSISTANT
}

/// How a message entered the conversation: typed in chat, or spoken on a call started from it.
enum ChatChannel {
  CHAT
  VOICE
}

enum ChatAnswerSource {
  AI
  /// Answered instantly from the author's verified records, without the AI.
  RECORDS
  SAFE_FALLBACK
  UNAVAILABLE
}

enum VoiceCallStatus {
  PENDING
  ACTIVE
  ENDED
  FAILED
  EXPIRED
}

enum VoiceEndReason {
  USER_HANGUP
  TIME_LIMIT
  ASSISTANT_ENDED
  IDLE
  DISCONNECTED
  DISABLED_BY_ADMIN
  PROVIDER_ERROR
  SERVER_RESTART
  /// The conversation reached its message limit during the call.
  TURN_LIMIT
}

enum MessageKind {
  AUTHOR
  REPLY
  INTERNAL_NOTE
  SYSTEM
}

enum AiJobKind {
  TRIAGE
  DRAFT
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FALLBACK
  /// Terminal: the rules fallback itself failed. Never reclaimed; staff write the reply.
  FAILED
}

enum DraftSource {
  AI
  TEMPLATE
}

enum AiRunOutcome {
  OK
  ERROR
}

/// A tenant: one business that signed up to the support product. Every tenant-owned row carries
/// its id. The default workspace ("bookleaf") is seeded from env and keeps today's behaviour.
model Workspace {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique
  name             String
  isDefault        Boolean   @default(false) @map("is_default")
  /// Fixed label prefix for this workspace's tickets (BL → BL-1001). Unique across the platform,
  /// so every full label is platform-unique; set once at creation and never changed (F-13).
  ticketPrefix     String    @unique @map("ticket_prefix")
  /// The number the next ticket gets. Taken with UPDATE … RETURNING inside the ticket insert's
  /// transaction: the row lock rules out duplicates and a rollback leaves no gap (F-13).
  nextTicketNumber Int       @default(1001) @map("next_ticket_number")
  /// U-12 setup guide signals, written at most once a minute and never read by anything else:
  /// the last valid hand-over token from the product, and the last widget page framed by one
  /// of the workspace's allowed sites (with that site's origin).
  lastHandOverAt   DateTime? @map("last_hand_over_at") @db.Timestamptz(3)
  lastWidgetLoadAt DateTime? @map("last_widget_load_at") @db.Timestamptz(3)
  lastWidgetOrigin String?   @map("last_widget_origin")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  members       WorkspaceMember[]
  users         User[]
  authors       Author[]
  books         Book[]
  tickets       Ticket[]
  chatSessions  ChatSession[]
  voiceSessions VoiceSession[]
  ticketDrafts  TicketDraft[]
  auditEvents   AuditEvent[]
  connector     WorkspaceConnector?
  settings      WorkspaceSettings?
  fields        CustomerField[]
  apiKeys       WorkspaceApiKey[]
  providerKeys  WorkspaceProviderKey[]
  webhooks      WorkspaceWebhook[]
  categories    Category[]
  articles      KnowledgeArticle[]
  plan          WorkspacePlan?
  aiRuns        AiRun[]
  dataSources   WorkspaceDataSource[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

/// How a workspace's customer data is fetched from its own product. Secrets are stored
/// envelope-encrypted (platform/crypto) and never returned; only a last-4 hint is.
model WorkspaceConnector {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @unique @map("workspace_id") @db.Uuid
  /// Older single-endpoint form; U-9 moved it into a CONTRACT data source. Dropped later (§17).
  baseUrl           String?   @map("base_url")
  signInUrl         String?   @map("sign_in_url")
  apiKeyEnc         String    @map("api_key_enc")
  apiKeyHint        String    @map("api_key_hint")
  signingSecretEnc  String    @map("signing_secret_enc")
  signingSecretHint String    @map("signing_secret_hint")
  timeoutMs         Int       @default(3000) @map("timeout_ms")
  cacheSeconds      Int       @default(60) @map("cache_seconds")
  lastTestAt        DateTime? @map("last_test_at") @db.Timestamptz(3)
  lastTestOk        Boolean?  @map("last_test_ok")
  lastTestDetail    String?   @map("last_test_detail")
  /// U-9: where name, email and the item list come from in MAPPED sources (RecordMappingSchema).
  recordMapping     Json?     @map("record_mapping")
  version           Int       @default(0)
  updatedById       String?   @map("updated_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("workspace_connectors")
}

/// One field of the workspace's customer-data schema: the facts its product sends.
/// `key` may contain `{id}` for per-item facts, e.g. `item.{id}.status`.
model CustomerField {
  id                String            @id @default(uuid()) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  key               String
  label             String
  type              CustomerFieldType
  /// Shown to the AI so it knows what the field means and when to use it.
  description       String            @default("")
  /// STATUS fields: the codes the product may send.
  allowedValues     String[]          @default([]) @map("allowed_values")
  visibleToCustomer Boolean           @default(true) @map("visible_to_customer")
  position          Int               @default(0)
  /// U-9: the MAPPED data source and JSON path holding this value (null = not mapped).
  sourceId          String?           @map("source_id") @db.Uuid
  path              String?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  source    WorkspaceDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, key])
  @@map("customer_fields")
}

enum DataSourceFormat {
  CONTRACT
  MAPPED
}

/// U-9: one GET endpoint of the workspace's product (1 to 5 per workspace). `urlTemplate` holds
/// `{id}` / `{email}`; the connector's API key goes as Bearer, or in `authHeader` when set.
model WorkspaceDataSource {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  name         String
  urlTemplate  String           @map("url_template")
  format       DataSourceFormat @default(MAPPED)
  authHeader   String?          @map("auth_header")
  timeoutMs    Int              @default(3000) @map("timeout_ms")
  cacheSeconds Int              @default(60) @map("cache_seconds")
  position     Int              @default(0)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  fields    CustomerField[]

  @@index([workspaceId, position])
  @@map("workspace_data_sources")
}

/// Per-workspace switches, limits, AI behaviour and widget settings, under RLS. A missing row means
/// "starting values". The model columns are no longer read or written: models are platform
/// settings now (U-7 expand step; dropped in a later release).
model WorkspaceSettings {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @unique @map("workspace_id") @db.Uuid
  triageModel        String?         @map("triage_model")
  draftModel         String?         @map("draft_model")
  chatModel          String?         @map("chat_model")
  toneGuide          String          @default("") @map("tone_guide")
  chatEnabled        Boolean         @default(false) @map("chat_enabled")
  messagesPerMinute  Int             @default(20) @map("messages_per_minute")
  messagesPerDay     Int             @default(100) @map("messages_per_day")
  maxTurnsPerSession Int             @default(30) @map("max_turns_per_session")
  voiceEnabled       Boolean         @default(false) @map("voice_enabled")
  voiceName          String          @default("marin") @map("voice_name")
  maxCallSeconds     Int             @default(300) @map("max_call_seconds")
  callsPerHour       Int             @default(5) @map("calls_per_hour")
  callsPerDay        Int             @default(10) @map("calls_per_day")
  allowedOrigins     String[]        @default([]) @map("allowed_origins")
  brandName          String          @default("") @map("brand_name")
  brandColor         String          @default("#2f6b4f") @map("brand_color")
  customerNoun       String          @default("customer") @map("customer_noun")
  itemNoun           String          @default("item") @map("item_noun")
  /// AI behaviour (U-7): the first line of replies and calls ({name} = the customer's first name).
  greeting           String          @default("")
  /// How reply drafts sign off; empty = "Warm regards, <brand> Support".
  signature          String          @default("")
  /// Null = not chosen: replies behave as before (English; calls follow VOICE_STYLE).
  replyLanguage      ReplyLanguage?  @map("reply_language")
  replyLength        ReplyLength?    @map("reply_length")
  formality          ReplyFormality?
  /// Subjects the AI must not discuss; it offers a ticket to the team instead.
  topicsToAvoid      String[]        @default([]) @map("topics_to_avoid")
  /// Shown in the widget header (https only); null = no logo.
  logoUrl            String?         @map("logo_url")
  /// The widget launcher's label on the host page; empty = "Help".
  launcherText       String          @default("") @map("launcher_text")
  widgetTheme        WidgetTheme     @default(AUTO) @map("widget_theme")
  version            Int             @default(0)
  updatedById        String?         @map("updated_by_id") @db.Uuid
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("workspace_settings")
}

/// A server-to-server key for the workspace's product. Only the hash is stored; the plain
/// key is shown once, at creation.
model WorkspaceApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  prefix      String
  keyHash     String    @unique @map("key_hash")
  scopes      String[]  @default([])
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@map("workspace_api_keys")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  email          String
  /// Null for authors: they sign in through the host product, never with a password here.
  passwordHash   String?  @map("password_hash")
  /// Staff only (password accounts): the email, trimmed and lowercased, unique across the whole
  /// platform, so email + password names exactly one account. Null for authors, whose email may
  /// exist in several workspaces (F-12).
  loginEmail     String?  @unique @map("login_email")
  /// Every session token carries the version it was issued with; a token whose version is not
  /// this one is refused (F-12 part 2). Bumped by logout (app), and by a password change and by
  /// removal from a workspace (database triggers, see migration 20261030100000_session_version).
  sessionVersion Int      @default(1) @map("session_version")
  name           String
  role           Role
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace       Workspace         @relation(fields: [workspaceId], references: [id])
  memberships     WorkspaceMember[]
  author          Author?
  assignedTickets Ticket[]          @relation("TicketAssignee")
  messages        TicketMessage[]
  auditEvents     AuditEvent[]

  @@unique([workspaceId, email])
  @@map("users")
}

model Author {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  externalId  String    @map("external_id")
  userId      String    @unique @map("user_id") @db.Uuid
  /// Host-owned details, no longer written (customer data is read from the host).
  phone       String?
  city        String?
  joinedDate  DateTime? @map("joined_date") @db.Date

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  books         Book[]
  tickets       Ticket[]
  chatSessions  ChatSession[]
  voiceSessions VoiceSession[]
  ticketDrafts  TicketDraft[]

  @@unique([workspaceId, externalId])
  @@map("authors")
}

model Book {
  id                  String     @id @default(uuid()) @db.Uuid
  workspaceId         String     @map("workspace_id") @db.Uuid
  externalId          String     @map("external_id")
  authorId            String     @map("author_id") @db.Uuid
  title               String
  /// The columns below are host-owned and no longer written; facts are read from the host.
  isbn                String?
  genre               String?
  publicationDate     DateTime?  @map("publication_date") @db.Date
  stage               BookStage?
  mrpPaise            Int?       @map("mrp_paise")
  royaltyPerCopyPaise Int?       @map("royalty_per_copy_paise")
  copiesSold          Int?       @map("copies_sold")
  royaltyEarnedPaise  Int?       @map("royalty_earned_paise")
  royaltyPaidPaise    Int?       @map("royalty_paid_paise")
  royaltyPendingPaise Int?       @map("royalty_pending_paise")
  lastPayoutDate      DateTime?  @map("last_payout_date") @db.Date
  printPartner        String?    @map("print_partner")
  availableOn         String[]   @default([]) @map("available_on")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  author       Author        @relation(fields: [authorId], references: [id])
  tickets      Ticket[]
  ticketDrafts TicketDraft[]

  @@unique([workspaceId, externalId])
  @@index([authorId])
  @@map("books")
}

model Ticket {
  id              String          @id @default(uuid()) @db.Uuid
  /// A label only, unique per workspace (shown as `${prefix}-${number}`, from 1001); the UUID is
  /// the identity. Taken from the workspace counter (F-13).
  number          Int
  workspaceId     String          @map("workspace_id") @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  bookId          String?         @map("book_id") @db.Uuid
  subject         String
  description     String
  status          TicketStatus    @default(OPEN)
  /// Old fixed category (S.9 expand step): no longer read or written; dropped in a later release.
  legacyCategory  TicketCategory? @map("category")
  /// The workspace category's key (S.9); keys never change once created.
  categoryKey     String?         @map("category_key")
  categorySource  FieldSource?    @map("category_source")
  aiConfidence    Float?          @map("ai_confidence")
  priority        Priority        @default(MEDIUM)
  prioritySource  FieldSource     @default(RULES) @map("priority_source")
  priorityReasons Json            @default("[]") @map("priority_reasons")
  needsInfo       Json            @default("[]") @map("needs_info")
  needsReview     Boolean         @default(false) @map("needs_review")
  aiState         AiState         @default(PENDING) @map("ai_state")
  assigneeId      String?         @map("assignee_id") @db.Uuid
  slaDueAt        DateTime        @map("sla_due_at") @db.Timestamptz(3)
  firstResponseAt DateTime?       @map("first_response_at") @db.Timestamptz(3)
  resolvedAt      DateTime?       @map("resolved_at") @db.Timestamptz(3)
  clientRequestId String?         @map("client_request_id")
  source          TicketSource    @default(PORTAL)
  chatSessionId   String?         @unique @map("chat_session_id") @db.Uuid
  voiceSessionId  String?         @unique @map("voice_session_id") @db.Uuid
  version         Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace       @relation(fields: [workspaceId], references: [id])
  author       Author          @relation(fields: [authorId], references: [id])
  chatSession  ChatSession?    @relation(fields: [chatSessionId], references: [id])
  voiceSession VoiceSession?   @relation(fields: [voiceSessionId], references: [id])
  book         Book?           @relation(fields: [bookId], references: [id])
  category     Category?       @relation(fields: [workspaceId, categoryKey], references: [workspaceId, key], onDelete: Restrict, onUpdate: Restrict)
  assignee     User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages     TicketMessage[]
  aiJobs       AiJob[]
  drafts       AiDraft[]
  aiRuns       AiRun[]
  ticketDraft  TicketDraft?

  @@unique([workspaceId, number])
  @@unique([authorId, clientRequestId])
  @@index([workspaceId, status, priority, slaDueAt])
  @@index([status, priority, slaDueAt])
  @@index([authorId, createdAt])
  @@index([workspaceId, categoryKey])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
  @@map("tickets")
}

model TicketMessage {
  id              String      @id @default(uuid()) @db.Uuid
  ticketId        String      @map("ticket_id") @db.Uuid
  senderId        String?     @map("sender_id") @db.Uuid
  kind            MessageKind
  body            String
  draftId         String?     @map("draft_id") @db.Uuid
  clientRequestId String?     @map("client_request_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id])
  sender User?  @relation(fields: [senderId], references: [id])

  @@unique([ticketId, clientRequestId])
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model AiJob {
  id             String      @id @default(uuid()) @db.Uuid
  ticketId       String      @map("ticket_id") @db.Uuid
  kind           AiJobKind
  generation     Int
  status         AiJobStatus @default(QUEUED)
  attempts       Int         @default(0)
  maxAttempts    Int         @default(3) @map("max_attempts")
  runAfter       DateTime    @default(now()) @map("run_after") @db.Timestamptz(3)
  leaseExpiresAt DateTime?   @map("lease_expires_at") @db.Timestamptz(3)
  lastErrorCode  String?     @map("last_error_code")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime?   @map("finished_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@unique([ticketId, kind, generation])
  @@index([status, runAfter])
  @@map("ai_jobs")
}

model AiDraft {
  id            String      @id @default(uuid()) @db.Uuid
  ticketId      String      @map("ticket_id") @db.Uuid
  generation    Int
  source        DraftSource
  body          String
  provider      String?
  model         String?
  promptVersion String?     @map("prompt_version")
  factsSnapshot Json        @map("facts_snapshot")
  claims        Json        @default("[]")
  checkResults  Json        @map("check_results")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, generation])
  @@map("ai_drafts")
}

model AiRun {
  id               String       @id @default(uuid()) @db.Uuid
  ticketId         String?      @map("ticket_id") @db.Uuid
  /// The customer the call was made for (usage and cost per customer, U-7). Null on older rows.
  workspaceId      String?      @map("workspace_id") @db.Uuid
  task             String
  provider         String
  model            String
  promptVersion    String?      @map("prompt_version")
  inputTokens      Int          @default(0) @map("input_tokens")
  outputTokens     Int          @default(0) @map("output_tokens")
  cacheReadTokens  Int          @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int          @default(0) @map("cache_write_tokens")
  costMicros       Int?         @map("cost_micros")
  latencyMs        Int          @map("latency_ms")
  outcome          AiRunOutcome
  errorCode        String?      @map("error_code")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket    Ticket?    @relation(fields: [ticketId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([workspaceId, createdAt])
  @@map("ai_runs")
}

/// Legacy (U-7 expand step): replaced by platform_settings, no longer read; dropped later.
model AiSettings {
  id             Int      @id @default(1)
  provider       String
  triageModel    String   @map("triage_model")
  draftModel     String   @map("draft_model")
  simulateOutage Boolean  @default(false) @map("simulate_outage")
  version        Int      @default(0)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("ai_settings")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  actor     User?      @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([workspaceId, createdAt])
  @@map("audit_events")
}

/// Legacy (U-7 expand step): replaced by platform_settings and workspace rows, no longer read.
model AssistantSettings {
  id           Int      @id @default(1)
  chatEnabled  Boolean  @default(false) @map("chat_enabled")
  voiceEnabled Boolean  @default(false) @map("voice_enabled")
  chatModel    String   @default("claude-haiku-5-5") @map("chat_model")
  version      Int      @default(0)
  updatedById  String?  @map("updated_by_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("assistant_settings")
}

model ChatSession {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  turnCount   Int      @default(0) @map("turn_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  author      Author         @relation(fields: [authorId], references: [id])
  messages    ChatMessage[]
  ticket      Ticket?
  ticketDraft TicketDraft?
  calls       VoiceSession[]

  @@index([authorId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id             String            @id @default(uuid()) @db.Uuid
  sessionId      String            @map("session_id") @db.Uuid
  role           ChatRole
  body           String
  source         ChatAnswerSource?
  /// Verified facts the answer relied on: [{id, label, display}] (assistant messages only).
  factsUsed      Json              @default("[]") @map("facts_used")
  /// Checker result for the shown answer (assistant messages only).
  check          Json?
  /// Ticket the assistant suggested raising: {subject, description, bookId}.
  proposal       Json?
  model          String?
  latencyMs      Int?              @map("latency_ms")
  channel        ChatChannel       @default(CHAT)
  /// The call a VOICE message was spoken on.
  voiceSessionId String?           @map("voice_session_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  session ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  call    VoiceSession? @relation(fields: [voiceSessionId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

/// One browser voice call. At most one PENDING/ACTIVE call per author (enforced under a row lock).
model VoiceSession {
  id              String          @id @default(uuid()) @db.Uuid
  workspaceId     String          @map("workspace_id") @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  status          VoiceCallStatus @default(PENDING)
  provider        String
  model           String
  maxSeconds      Int             @map("max_seconds")
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?       @map("ended_at") @db.Timestamptz(3)
  endReason       VoiceEndReason? @map("end_reason")
  durationSeconds Int?            @map("duration_seconds")
  /// [{role: "AUTHOR" | "ASSISTANT", text, at}] in spoken order.
  transcript      Json            @default("[]")
  /// Ticket the assistant suggested during the call: {subject, description, bookId}.
  proposal        Json?
  /// Checker result for every figure the assistant spoke, against the call's facts snapshot.
  spokenCheck     Json?           @map("spoken_check")
  inputTokens     Int             @default(0) @map("input_tokens")
  outputTokens    Int             @default(0) @map("output_tokens")
  /// The first call of a thread (its own id for a first call; older rows: null). Continued calls share it.
  threadId        String?         @map("thread_id") @db.Uuid
  /// The chat conversation this call was started from; its lines are saved there when it ends.
  chatSessionId   String?         @map("chat_session_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  author       Author        @relation(fields: [authorId], references: [id])
  ticket       Ticket?
  chatSession  ChatSession?  @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  chatMessages ChatMessage[]

  @@index([authorId, createdAt])
  @@index([threadId])
  @@index([chatSessionId])
  @@map("voice_sessions")
}

/// The ticket an author and the assistant prepare together in a chat conversation or call thread.
/// Exactly one of chatSessionId / voiceThreadId is set (CHECK constraint in the migration).
model TicketDraft {
  id             String            @id @default(uuid()) @db.Uuid
  workspaceId    String            @map("workspace_id") @db.Uuid
  authorId       String            @map("author_id") @db.Uuid
  chatSessionId  String?           @unique @map("chat_session_id") @db.Uuid
  voiceThreadId  String?           @unique @map("voice_thread_id") @db.Uuid
  /// Old fixed category (S.9 expand step): no longer read or written; dropped in a later release.
  legacyCategory TicketCategory?   @map("category")
  /// The workspace category's key (S.9).
  categoryKey    String?           @map("category_key")
  bookId         String?           @map("book_id") @db.Uuid
  subject        String            @default("")
  description    String            @default("")
  status         TicketDraftStatus @default(OPEN)
  version        Int               @default(0)
  lastEditedBy   DraftEditor       @default(ASSISTANT) @map("last_edited_by")
  ticketId       String?           @unique @map("ticket_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  author      Author       @relation(fields: [authorId], references: [id])
  chatSession ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  book        Book?        @relation(fields: [bookId], references: [id])
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  category    Category?    @relation(fields: [workspaceId, categoryKey], references: [workspaceId, key], onDelete: Restrict, onUpdate: Restrict)

  @@index([authorId])
  @@map("ticket_drafts")
}

/// What a workspace's own provider key is for.
enum ProviderCapability {
  AI
  VOICE
}

/// Legacy (U-7): customers no longer bring their own keys; every customer runs on the platform's
/// keys (platform_provider_keys). No longer read or written; dropped in a later release.
model WorkspaceProviderKey {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  capability  ProviderCapability
  provider    String
  keyEnc      String             @map("key_enc")
  last4       String             @map("last4")
  updatedById String?            @map("updated_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, capability])
  @@map("workspace_provider_keys")
}

/// Where a workspace's server is told about ticket events. The signing secret is encrypted.
model WorkspaceWebhook {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  url         String
  events      String[]
  secretEnc   String   @map("secret_enc")
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace         @relation(fields: [workspaceId], references: [id])
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("workspace_webhooks")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One event for one webhook (the outbox): written in the same transaction as the change.
model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  webhookId      String                @map("webhook_id") @db.Uuid
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil     DateTime?             @map("lease_until") @db.Timestamptz(3)
  responseStatus Int?                  @map("response_status")
  lastError      String?               @map("last_error")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt    DateTime?             @map("delivered_at") @db.Timestamptz(3)

  webhook WorkspaceWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

/// A workspace's own ticket category (S.9). The key is fixed once created: tickets, drafts and
/// knowledge articles link to it by (workspace_id, key). Categories are deactivated, never deleted.
model Category {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  key             String
  label           String
  /// Shown to the AI triage: what belongs in this category.
  description     String
  defaultPriority Priority @default(MEDIUM) @map("default_priority")
  /// First-response target in hours; null = the priority's target alone.
  slaHours        Int?     @map("sla_hours")
  position        Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace                  @relation(fields: [workspaceId], references: [id])
  tickets      Ticket[]
  ticketDrafts TicketDraft[]
  articles     KnowledgeArticleCategory[]

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("ticket_categories")
}

/// One knowledge-base article of a workspace (S.9). AI drafts get only the active articles linked
/// to the ticket's category; the chat assistant gets all of the workspace's active articles.
model KnowledgeArticle {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  title       String
  body        String
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace                  @relation(fields: [workspaceId], references: [id])
  categories KnowledgeArticleCategory[]

  @@unique([workspaceId, id])
  @@index([workspaceId, position])
  @@map("knowledge_articles")
}

/// Which categories an article belongs to. Both foreign keys include the workspace, so an article
/// can never be linked to another workspace's category.
model KnowledgeArticleCategory {
  workspaceId String @map("workspace_id") @db.Uuid
  articleId   String @map("article_id") @db.Uuid
  categoryKey String @map("category_key")

  article  KnowledgeArticle @relation(fields: [workspaceId, articleId], references: [workspaceId, id], onDelete: Cascade)
  category Category         @relation(fields: [workspaceId, categoryKey], references: [workspaceId, key], onDelete: Restrict, onUpdate: Restrict)

  @@id([articleId, categoryKey])
  @@index([workspaceId, categoryKey])
  @@map("knowledge_article_categories")
}

enum ReplyLanguage {
  ENGLISH
  HINGLISH
  /// Answer in the language the customer writes or speaks in.
  MATCH
}

enum ReplyLength {
  SHORT
  MEDIUM
  DETAILED
}

enum ReplyFormality {
  FORMAL
  NEUTRAL
  FRIENDLY
}

enum WidgetTheme {
  AUTO
  LIGHT
  DARK
}

/// The support provider's own operators (super admins, U-7). No signup: created and updated on
/// every deploy from PLATFORM_ADMIN_EMAIL / PLATFORM_ADMIN_PASSWORD. Platform table: the
/// restricted app role has no grant on it; only the owner connection reads it.
model PlatformAdmin {
  id             String   @id @default(uuid()) @db.Uuid
  /// Trimmed and lowercased.
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  /// Bumped on logout and password change: older platform tokens stop working.
  sessionVersion Int      @default(1) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_admins")
}

/// The one row of shared AI settings every customer runs on (U-7): provider, models and the
/// global outage switch. Replaces the ai_settings / assistant_settings singletons. Platform table.
model PlatformSettings {
  id             Int       @id @default(1)
  provider       String
  triageModel    String    @map("triage_model")
  draftModel     String    @map("draft_model")
  chatModel      String    @map("chat_model")
  /// Null = VOICE_MODEL from env.
  voiceModel     String?   @map("voice_model")
  simulateOutage Boolean   @default(false) @map("simulate_outage")
  /// The console's last "Test connection" result, so every copy shows the same one after restarts.
  lastTestAt     DateTime? @map("last_test_at") @db.Timestamptz(3)
  lastTestOk     Boolean?  @map("last_test_ok")
  lastTestDetail String?   @map("last_test_detail")
  version        Int       @default(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

/// An AI or voice provider key saved by a super admin, envelope-encrypted with SECRETS_MASTER_KEY.
/// It wins over the env key for that provider; without one the env key is used. Platform table.
model PlatformProviderKey {
  id         String             @id @default(uuid()) @db.Uuid
  capability ProviderCapability
  provider   String
  keyEnc     String             @map("key_enc")
  last4      String
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([capability, provider])
  @@map("platform_provider_keys")
}

/// What one customer may use (U-7): features and the most it may set its own limits to, AI off
/// for this customer, and suspension. Set by super admins only. Platform table.
model WorkspacePlan {
  workspaceId          String    @id @map("workspace_id") @db.Uuid
  chatAllowed          Boolean   @default(true) @map("chat_allowed")
  voiceAllowed         Boolean   @default(true) @map("voice_allowed")
  aiEnabled            Boolean   @default(true) @map("ai_enabled")
  maxMessagesPerMinute Int       @default(120) @map("max_messages_per_minute")
  maxMessagesPerDay    Int       @default(2000) @map("max_messages_per_day")
  maxTurnsPerSession   Int       @default(200) @map("max_turns_per_session")
  maxCallsPerHour      Int       @default(60) @map("max_calls_per_hour")
  maxCallsPerDay       Int       @default(200) @map("max_calls_per_day")
  maxCallSeconds       Int       @default(300) @map("max_call_seconds")
  /// Set: the customer's staff, authors and API keys are refused until it is cleared.
  suspendedAt          DateTime? @map("suspended_at") @db.Timestamptz(3)
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_plans")
}
