# Copy to .env and fill in. Never commit .env.

# Server
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Built web app served by the API in production (`pnpm build`); path is relative to apps/api
WEB_DIST_DIR=../web/dist

# Database (docker compose: `pnpm db:up` starts Postgres on port 5433)
DATABASE_URL=postgresql://bookleaf:bookleaf@localhost:5433/bookleaf

# Auth: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_TTL_HOURS=8

# Business clock: payout maths runs "as of" this date (the seed data snapshot ends Dec 2025)
DATA_AS_OF=2025-12-31

# AI provider key (server only). Leave empty to run on the rule-based fallback.
ANTHROPIC_API_KEY=

# Seed passwords for demo accounts (used only by `pnpm db:seed`)
SEED_AUTHOR_PASSWORD=Author@BookLeaf1
SEED_ADMIN_PASSWORD=Admin@BookLeaf1
