# Copy to .env and fill in. Never commit .env.
# Grouped the same way as apps/api/src/config/*.ts — one block per file.

# --- server.ts ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# The one browser origin allowed to call the API
APP_ORIGIN=http://localhost:5173
# Optional: the integration guide (docs/integration.md) as admins can open it, e.g. its page in
# the repository. The admin "Get started" guide links there; empty = it names the file instead.
INTEGRATION_DOCS_URL=
LOG_LEVEL=info
# Built web app served by the API in production (`pnpm build`); relative to apps/api
WEB_DIST_DIR=../web/dist

# --- database.ts --- (docker compose: `pnpm db:up` starts Postgres on port 5433)
# Two roles on one database (S.8, row-level security):
# - DATABASE_URL: the restricted app role every request runs on. `npm run local` / `pnpm db:roles`
#   creates it (and updates its password) from the user and password written here.
# - DATABASE_ADMIN_URL: the owner. Migrations, seed, signup, sign-in lookups and the AI worker.
DATABASE_URL=postgresql://bookleaf_app:bookleaf-app-local@localhost:5433/bookleaf
DATABASE_ADMIN_URL=postgresql://bookleaf:bookleaf@localhost:5433/bookleaf

# --- shared-state.ts --- Redis shared by every copy of the API (live updates, rate limits,
# one-use tokens, chat order, settings-cache clearing). Required in production.
# docker compose (`npm run local` / `pnpm db:up`) starts Redis on port 6380.
REDIS_URL=redis://localhost:6380
# Every Redis key and channel starts with this, so several apps can share one Redis.
REDIS_KEY_PREFIX=bookleaf

# --- auth.ts --- at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_TTL_HOURS=8

# --- ai.ts --- leave the key empty to run on the rule-based fallback
ANTHROPIC_API_KEY=
DATA_AS_OF=2025-12-31
WORKER_ENABLED=true
WORKER_POLL_MS=1000

# --- chat.ts --- abuse limits (admins switch chat on or off in the UI)
CHAT_MESSAGES_PER_MINUTE=20
CHAT_MESSAGES_PER_DAY=100
CHAT_MAX_TURNS_PER_SESSION=30
CHAT_SESSIONS_PER_HOUR=10
TICKET_DRAFT_EDITS_PER_MINUTE=120

# --- voice.ts --- leave the key empty and voice calls are unavailable
VOICE_MAX_CALL_SECONDS=300
VOICE_CALLS_PER_HOUR=5
VOICE_CALLS_PER_DAY=10
VOICE_PROVIDER=openai
VOICE_MODEL=gpt-realtime-2.1
VOICE_NAME=marin
# How the voice assistant speaks: hinglish (warm Hinglish that mirrors the author) or english.
VOICE_STYLE=hinglish
OPENAI_API_KEY=
# Only when the web app is served from another site than the API (e.g. Vercel): the API's
# public wss:// origin. Voice calls then connect there with a one-time ticket. Empty = same host.
PUBLIC_API_WS_ORIGIN=

# --- host.ts --- the product this support module is attached to (apps/host-demo here).
# Customer data is read only from it. KEY and SECRET are shared with the host; generate
# each with `openssl rand -base64 48`.
HOST_API_URL=http://localhost:3200
HOST_API_KEY=replace-with-a-long-random-api-key
HOST_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Where authors sign in to BookLeaf (the dashboard dev server in `npm run local`)
HOST_SIGN_IN_URL=http://localhost:5174
# Embed mode: host page origins allowed to frame the widget (comma-separated). Empty = off.
# `npm run local` serves the BookLeaf dashboard on 5174, so it is allowed here.
HOST_ORIGINS=http://localhost:5174
# Embed mode for workspaces' own allowed origins (set in the settings screen), without HOST_ORIGINS.
EMBED_ENABLED=false
HOST_TIMEOUT_MS=3000
HOST_CACHE_SECONDS=60

# --- apps/host-demo only (the stand-in BookLeaf product) ---
HOST_DEMO_PORT=3200
# Where the support app is reachable: the web dev server, or APP_ORIGIN in production
SUPPORT_URL=http://localhost:5173
# BookLeaf's workspace slug in the support module: the widget opens /embed/<slug>. Default bookleaf.
SUPPORT_WORKSPACE=bookleaf
HOST_DEMO_PASSWORD=Author@BookLeaf1
# Session cookie only over HTTPS: true when deployed behind TLS, false for local plain HTTP.
HOST_SECURE_COOKIES=false

# --- seed only (`pnpm db:seed`) ---
SEED_ADMIN_PASSWORD=Admin@BookLeaf1
# The super admin console (/platform, U-7). There is no sign-up: the seed creates or updates this
# one account (a new password signs its old sessions out). Set both or neither. Password: 12+
# characters with a letter and a digit. In production these come from the box's env secret.
PLATFORM_ADMIN_EMAIL=owner@support.local
PLATFORM_ADMIN_PASSWORD=Platform@Owner1

# --- platform.ts --- multi-tenant platform settings (tenant settings live in the database)
# Master key for encrypting each workspace's secrets: `openssl rand -base64 32`. Required in production.
# `npm run local` replaces this placeholder with a random key; production refuses the placeholder.
SECRETS_MASTER_KEY=replace-with-a-random-base64-key-of-32-bytes-or-more
# Previous master key while rotating (optional)
SECRETS_MASTER_KEY_PREVIOUS=
# Development only: let a workspace's connector URL point at localhost (e.g. host-demo)
CONNECTOR_ALLOW_PRIVATE_HOSTS=true
SIGNUPS_PER_HOUR=5
