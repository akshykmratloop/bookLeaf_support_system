{
  "name": "bookleaf-support-portal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bookleaf/api --filter @bookleaf/web --filter @bookleaf/host-demo --filter @bookleaf/host-web dev",
    "build": "pnpm --filter @bookleaf/web build && pnpm --filter @bookleaf/api build",
    "start": "pnpm --filter @bookleaf/api start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @bookleaf/api db:migrate",
    "db:seed": "pnpm --filter @bookleaf/api db:seed",
    "eval": "pnpm --filter @bookleaf/api eval",
    "host:start": "pnpm --filter @bookleaf/host-demo start",
    "host:build": "pnpm --filter @bookleaf/host-web build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.2"
  }
}
