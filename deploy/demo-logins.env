# Published demo logins for the live demo (README "Live demo"). They are NOT secrets: the brief asks
# for test credentials in the README, and the login pages offer one-click sign-in with them.
# Loaded after the rendered secret env, so these values win over the older ones in the secret.
# Authors sign in as <first name>@bookleaf.com (apps/host-demo/src/data/authors.ts).
HOST_DEMO_PASSWORD=TestBookLeaf@123
# Support staff: admin@bookleaf.com and ops2@bookleaf.com (apps/api/src/seed/demo-accounts.ts).
SEED_ADMIN_PASSWORD=TestBookLeaf@123
# Super admin of the support provider's console (/platform). No one-click button for this one.
PLATFORM_ADMIN_EMAIL=superadmin@support.com
PLATFORM_ADMIN_PASSWORD=TestBookLeaf@123
