# The support API for the demo box (the web app is served by Vercel, so it is not built here).
# Build from the repo root:  docker build -f deploy/Dockerfile.api -t bookleaf-api .
# Migrations run before the server starts (`prisma migrate deploy`, never `db push`).

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@bookleaf/api..."
RUN pnpm --filter @bookleaf/api build
RUN pnpm deploy --filter @bookleaf/api --prod --legacy /out && cp -r apps/api/dist /out/dist

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /out /app
RUN npx prisma generate
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/health >/dev/null || exit 1
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]
