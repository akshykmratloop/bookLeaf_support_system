# The support API for the demo box. Build from the repo root:
#   docker build -f deploy/Dockerfile.api -t bookleaf-api .
# Vercel serves the web app, but the API also carries the same web build (WEB_DIST_DIR): Vercel
# forwards the widget pages (/embed/<slug>) here, so each one gets its own workspace's
# frame-ancestors header from the database (F-18). Static files still come from Vercel.
# Migrations run before the server starts (`prisma migrate deploy`, never `db push`), as the owner
# (DATABASE_ADMIN_URL). up.sh runs them, and the app role setup (`node dist/db-roles.js`, S.8),
# in a one-off container first, so the server's own migrate step finds nothing left to do.

FROM node:22.23.4-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@bookleaf/api..." --filter "@bookleaf/web..."
RUN pnpm --filter @bookleaf/web build && pnpm --filter @bookleaf/api build
RUN pnpm deploy --filter @bookleaf/api --prod --legacy /out && cp -r apps/api/dist /out/dist \
  && cp -r apps/web/dist /out/web

FROM node:22.23.4-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 WEB_DIST_DIR=/app/web
COPY --from=build /out /app
RUN npx prisma generate
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/health >/dev/null || exit 1
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]
