# The stand-in BookLeaf product's server for the demo box (its dashboard is served by Vercel).
# Build from the repo root:  docker build -f deploy/Dockerfile.host-demo -t bookleaf-host-demo .
# It runs its TypeScript directly with tsx (no build step) and reads src/data/sample-data.json.

FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@bookleaf/host-demo..."
ENV NODE_ENV=production HOST_DEMO_PORT=3200
USER node
WORKDIR /app/apps/host-demo
EXPOSE 3200
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3200/health >/dev/null || exit 1
CMD ["node_modules/.bin/tsx", "src/server.ts"]
